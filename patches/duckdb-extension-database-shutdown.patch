+void ExtensionCallbackManager::RegisterDatabaseShutdownCallback(DatabaseShutdownCallback callback) {
+	if (!callback) {
+		throw InvalidInputException("Cannot register a null database-shutdown callback");
+	}
+	lock_guard<mutex> guard(registry_lock);
+	auto new_registry = CopyRegistry();
+	new_registry->database_shutdown_callbacks.push_back(std::move(callback));
+	PublishRegistry(std::move(new_registry));
+}
+
+void ExtensionCallbackManager::RunDatabaseShutdownCallbacks(DatabaseInstance &db) const {
+	auto registry = callback_registry.load();
+	for (auto &callback : registry->database_shutdown_callbacks) {
+		callback(db);
+	}
+}
