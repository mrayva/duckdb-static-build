+void QuackStorageExtensionInfo::RegisterClientConnection(const shared_ptr<QuackClientConnection> &connection) {
+	std::lock_guard<std::mutex> lock(client_connections_mutex);
+	if (shutting_down) {
+		connection->StopHeartbeat();
+		return;
+	}
+	client_connections.erase(
+	    std::remove_if(client_connections.begin(), client_connections.end(),
+	                   [](const weak_ptr<QuackClientConnection> &entry) { return entry.expired(); }),
+	    client_connections.end());
+	client_connections.push_back(connection);
+}
+
+void QuackStorageExtensionInfo::StopClientHeartbeats() {
+	vector<shared_ptr<QuackClientConnection>> connections;
+	{
+		std::lock_guard<std::mutex> lock(client_connections_mutex);
+		shutting_down = true;
+		for (auto &entry : client_connections) {
+			if (auto connection = entry.lock()) {
+				connections.push_back(std::move(connection));
+			}
+		}
+		client_connections.clear();
+	}
+	for (auto &connection : connections) {
+		connection->StopHeartbeat();
+	}
+}
