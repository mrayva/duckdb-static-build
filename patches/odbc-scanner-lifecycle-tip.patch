+
+static void odbc_destroy_params_function(duckdb_function_info info, duckdb_data_chunk input,
+                                         duckdb_vector output) noexcept {
+	try {
+		odbcscanner::DestroyParams(info, input, output);
+	} catch (std::exception &e) {
+		duckdb_scalar_function_set_error(info, e.what());
+	}
+}
