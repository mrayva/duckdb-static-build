+void OdbcDestroyParamsFunction::Register(duckdb_connection conn) {
+	auto fun = ScalarFunctionPtr(duckdb_create_scalar_function(), ScalarFunctionDeleter);
+	duckdb_scalar_function_set_name(fun.get(), "odbc_destroy_params");
+
+	auto bigint_type = LogicalTypePtr(duckdb_create_logical_type(DUCKDB_TYPE_BIGINT), LogicalTypeDeleter);
+	auto bool_type = LogicalTypePtr(duckdb_create_logical_type(DUCKDB_TYPE_BOOLEAN), LogicalTypeDeleter);
+	duckdb_scalar_function_add_parameter(fun.get(), bigint_type.get());
+	duckdb_scalar_function_set_return_type(fun.get(), bool_type.get());
+	duckdb_scalar_function_set_function(fun.get(), odbc_destroy_params_function);
+	duckdb_scalar_function_set_special_handling(fun.get());
+	duckdb_scalar_function_set_volatile(fun.get());
+
+	duckdb_state state = duckdb_register_scalar_function(conn, fun.get());
+	if (state != DuckDBSuccess) {
+		throw ScannerException("'odbc_destroy_params' function registration failed");
+	}
+}
+
 } // namespace odbcscanner
 
