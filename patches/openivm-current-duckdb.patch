+			D_ASSERT(parsed.size() == 1);
+			ParsedExpressionIterator::VisitExpressionMutable<ColumnRefExpression>(
+			    *parsed[0], [&](ColumnRefExpression &colref) {
+				    auto entry = rename_map.find(colref.GetColumnName().GetIdentifierName());
